[layer_names]

3d_physics/layer_1="mundo"
3d_physics/layer_2="jugador"
3d_physics/layer_3="interactuables"
3d_physics/layer_4="usables"
3d_physics/layer_5="npc"
3d_physics/layer_6="limites"
3d_physics/layer_7="solo_jugador"
3d_physics/layer_8="solo_camara"
3d_render/layer_20="techos_interiores"

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="forward_plus"

anti_aliasing/quality/msaa_3d=1

