; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mala Hierba"
config/version="0.3.0-preview.1"
config/description="Juego de granja en 3D: Leo hereda El Granado y tiene un año para sacarlo adelante."
run/main_scene="res://escenas/menu_principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icono.png"
config/windows_native_icon="res://assets/ui/icono.ico"

[autoload]

Ajustes="*res://scripts/autoload/ajustes.gd"
Audio="*res://scripts/autoload/audio.gd"
Datos="*res://scripts/autoload/datos.gd"
Juego="*res://scripts/autoload/juego.gd"
Escenas="*res://scripts/autoload/escenas.gd"
Interfaz="*res://escenas/ui/interfaz.tscn"
Cultivos="*res://scripts/granja/cultivos.gd"
Tutorial="*res://scripts/autoload/tutorial.gd"
Misiones="*res://scripts/autoload/misiones.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

